{
  "name": "@cajax/bulkhead-limit",
  "version": "0.1.0",
  "description": "Zero-dependency bulkhead concurrency limiter: bounded queue, queue-wait deadlines, abort-aware, priority, adaptive (AIMD) concurrency.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fetch": {
      "import": {
        "types": "./dist/fetch.d.ts",
        "default": "./dist/fetch.js"
      },
      "require": {
        "types": "./dist/fetch.d.cts",
        "default": "./dist/fetch.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "fetch": [
        "./dist/fetch.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint . && tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "tsup",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "simulator": "npm run build && node examples/simulator/server.mjs",
    "check:package": "publint --strict && attw --pack ."
  },
  "keywords": [
    "bulkhead",
    "concurrency",
    "limit",
    "queue",
    "backpressure",
    "load-shedding",
    "timeout",
    "abort",
    "priority",
    "aimd",
    "rate-limit",
    "promise"
  ],
  "author": "cajax",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cajax/bulkhead-limit.git"
  },
  "bugs": {
    "url": "https://github.com/cajax/bulkhead-limit/issues"
  },
  "homepage": "https://github.com/cajax/bulkhead-limit",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "ts-jest": "^29.4.15",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
